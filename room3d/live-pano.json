{
 "version": 1,
 "kind": "sfw-panorama",
 "look": "crisp",
 "source": "R2 full set, crisp look: city 64 px/deg, sky 32 (scripts/pano_production.py)",
 "projection": "equirectangular: column = yaw (deg right of the room axis), row = elevation (deg), row 0 at the top",
 "axis_bearing_deg": 291.6564,
 "eye": {
  "room_engine": [
   0.0,
   1.17,
   1.05
  ],
  "asl_m": 112.64,
  "world_m": [
   0.0,
   0.0,
   112.636
  ],
  "note": "the desk eye, which is the photo camera's eye: every pass (bands, clouds, aux) renders from this one point. room_engine is it in the room's engine coordinates (x right, y up, -z out of the window; room.py CAM: 1.17 m above the room floor, 1.05 m back from the window). world_m is it in build.py's world (x east, y north, z up from the water; build.py places the room so its camera lands on (0, 0, ground + --eye)), so asl_m (= world_m z) is the eye's height above the water and the room floor is at asl_m - 1.17. (The fake panorama's 113.81 added the 1.17 a second time.)"
 },
 "yaw": [
  -56.0,
  56.0
 ],
 "columns": 7,
 "column_deg": 16.0,
 "gutter": 2,
 "bands": {
  "city": {
   "el": [
    -22.0,
    6.0
   ],
   "levels": {
    "L0": 64,
    "L1": 32,
    "L2": 16
   }
  },
  "sky": {
   "el": [
    6.0,
    56.0
   ],
   "levels": {
    "L1": 32,
    "L2": 16
   }
  }
 },
 "tiles": "{moment}/{band}-{level}-{col}.avif (L0, L1); {moment}/{band}-L2.avif (the whole band)",
 "tile_layout": "column c covers yaw [-56 + 16c, -40 + 16c]; each tile carries a 2 px gutter on all four sides (the neighbouring panorama pixels at that level), so a tile is (16 ppd + 4) x (band ppd + 4)",
 "aux": {
  "mask": "r2pano/aux/mask.png",
  "depth": "r2pano/aux/depth.png",
  "ppd": 20,
  "band": "city",
  "gutter": 2,
  "mask_channels": "R sky, G water, B fog opacity (at the moment's full fog; scaled by the moment's fog)",
  "depth_channels": "R the far scene's soft depth (the near layer taken out; grown 0.1 deg, smoothed) for the far layer's parallax, G sharp depth of the whole panorama for occlusion, B the near layer's depth grown out past its outline by layers.radius_deg (255 = no near layer within reach)",
  "depth_encoding": "log(d / 10 m) / log(6000): 0 = 10 m, 1 = 60 km or sky (build.py's aux pass)"
 },
 "clouds": {
  "ppd": 16,
  "yaw": [
   -76.0,
   76.0
  ],
  "el": [
   -3.0,
   45.0
  ],
  "gutter": 2,
  "format": "RGBA, straight alpha, sRGB, composited over the base where the mask says sky"
 },
 "lights": {
  "ppd": 32,
  "band": "city",
  "channels": "R windows, G street lamps, B floodlights: brightness (display units) added as brightness x tint; the base is all off",
  "cells": "window cell = floor((top - el) * 28) * 65536 + floor((yaw + 56) * 28)"
 },
 "far_el": [
  -22.0,
  6.0
 ],
 "layers": {
  "far": {
   "el": [
    -22.0,
    6.0
   ],
   "levels": {
    "L1": 32,
    "L2": 16
   },
   "tiles": "{moment}/far-{level}-{col}.avif (L1); {moment}/far-L2.avif (the whole far band)",
   "format": "RGBA: RGB the panorama with the near layer taken out (what lies behind it), A the near layer's coverage in the panorama (the near layer itself is the panorama's own pixels there)",
   "tile_layout": "as the city band's tiles, over the far band's elevations"
  },
  "near": {
   "max_m": 350.0,
